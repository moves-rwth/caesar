// RUN: @caesar @file

// Verify wp[geometric](count) <= init_count + [init_running].
@wp
coproc geometric(init_count: UInt, init_running: Bool) -> (count: UInt, running: Bool)
    pre init_count + [init_running]
    post count
{
    count = init_count
    running = init_running
    if running {
        var stop: Bool = flip(0.5)
        if stop {
            running = false
        } else {
            count = count + 1
        }
        // Apply the same specification to the recursive call with the updated arguments.
        count, running = geometric(count, running)
    } else {}
}
