// RUN: @caesar @file --quantifier-instantiation e-matching

// Adapted from the complete Figure 1 example in the CAV 2026 Caesar artifact.
// Paper: https://doi.org/10.1007/978-3-032-32537-2_27
// Original artifact source: tests/case-studies/brp-send-packet.heyvl.
// Changes: combined invariant cases with minimum, maximum, and Boolean embeddings.
// Added an upper bound on the actual number of failed transmission attempts.

domain Exponentials {
    func pow(base: UReal, exponent: UInt): UReal =
        ite(exponent == 0, 1, base * pow(base, exponent - 1))

    axiom pow_bounded forall base: UReal, exponent: UInt.
        (base <= 1) ==> (pow(base, exponent) <= 1)
}

@wp
coproc brp(packets: UInt, maxTries: UInt)
    -> (sent: UInt, fail: UInt, totalFail: UInt)
    pre !?(maxTries > 0)
    pre 1 - pow(1 - pow(0.01, maxTries), packets)
    post [fail == maxTries]
{
    sent = 0
    fail = 0
    totalFail = 0

    // Failure is certain at the retry limit; otherwise combine this packet and the later packets.
    @invariant(
        !?(sent <= packets && fail <= maxTries)
        ⊔ [fail == maxTries]
        ⊔ (?(sent < packets && fail < maxTries)
            ⊓ (1 - (1 - pow(0.01, maxTries - fail))
                * pow(1 - pow(0.01, maxTries), (packets - sent) - 1)))
    )
    while sent < packets && fail < maxTries {
        var transmit: Bool = flip(0.99)
        if transmit {
            sent = sent + 1
            fail = 0
        } else {
            fail = fail + 1
            totalFail = totalFail + 1
        }
    }
}

@wp
coproc brp_failed_transmissions(packets: UInt, maxTries: UInt)
    -> (sent: UInt, fail: UInt, totalFail: UInt)
    pre 0.01 * maxTries * packets
    post totalFail
{
    sent = 0
    fail = 0
    totalFail = 0

    // Each unused transmission slot contributes at most its failure probability.
    // Delivery can discard several remaining slots, while a failure consumes one.
    @invariant(
        !?(sent <= packets && fail <= maxTries)
        ⊔ (totalFail + 0.01 * (maxTries * (packets - sent) - fail))
    )
    while sent < packets && fail < maxTries {
        var transmit: Bool = flip(0.99)
        if transmit {
            sent = sent + 1
            fail = 0
        } else {
            fail = fail + 1
            totalFail = totalFail + 1
        }
    }
}
