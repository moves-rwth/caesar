// RUN: @caesar @file

@wp
proc noisy_or(target: Bool) -> (n3: Bool)
    pre [target] * (130307/160000) + [!target] * (29693/160000)
    post [n3 == target]
{
    var n1: Bool
    var n21: Bool
    var n22: Bool
    var n31: Bool
    var n32: Bool
    var n33: Bool
    var n0: Bool = flip(1/2)
    var n4: Bool = flip(1/2)
    if n0 {
        n1 = flip(4/5)
        n21 = flip(4/5)
    } else {
        n1 = flip(1/10)
        n21 = flip(1/10)
    }
    if n4 {
        n22 = flip(4/5)
        n33 = flip(4/5)
    } else {
        n22 = flip(1/10)
        n33 = flip(1/10)
    }
    var n2: Bool = n21 || n22
    if n1 {
        n31 = flip(4/5)
    } else {
        n31 = flip(1/10)
    }
    if n2 {
        n32 = flip(4/5)
    } else {
        n32 = flip(1/10)
    }
    n3 = n31 || n32 || n33
}
