// RUN: @caesar @file

// Bound the unnormalized expected die result after discarding outcomes 7 and 8.
@wp
coproc die_wp() -> (r: EUReal)
    pre 2.625
    post r
{
    var a: Bool = flip(0.5)
    var b: Bool = flip(0.5)
    var c: Bool = flip(0.5)
    r = 4 * [a] + 2 * [b] + [c] + 1
    assert ?(r <= 6)
}

// Bound the probability that the sampled outcome is retained.
@wlp
proc die_wlp() -> (r: EUReal)
    pre 6/8
    post 1
{
    var a: Bool = flip(0.5)
    var b: Bool = flip(0.5)
    var c: Bool = flip(0.5)
    r = 4 * [a] + 2 * [b] + [c] + 1
    assert ?(r <= 6)
}
