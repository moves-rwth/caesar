// RUN: @caesar @file
// Adapted from geo1.pgcl, translated by pgcl2heyvl.

@wp
coproc geometric(init_count: UInt, init_running: Bool) -> (count: UInt, running: Bool)
    pre init_count + 1
    post count
{
    count = init_count
    running = init_running
    // The second guard check uses post count when running is false.
    @k_induction(2, count + 1)
    while running {
        var stop: Bool = flip(0.5)
        if stop {
            running = false
        } else {
            count = count + 1
        }
    }
}
