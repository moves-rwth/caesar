// RUN: @caesar @file
// Adapted from sprdwalk.pgcl, translated by pgcl2heyvl.

@ert
coproc forward_walk(init_x: UInt, init_n: UInt) -> (x: UInt, n: UInt)
    pre 2 * (init_n - init_x)
    post 0
{
    x = init_x
    n = init_n
    // Twice the remaining distance bounds the expected number of coin flips.
    @invariant(2 * (n - x))
    while x < n {
        var step: Bool = flip(0.5)
        if step {
            x = x + 1
        } else {}
        tick 1
    }
}
