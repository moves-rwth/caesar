// RUN: @caesar @file
// Adapted from rdwalk.pgcl, translated by pgcl2heyvl.

@ert
coproc drift_walk(init_x: UInt, init_n: UInt) -> (x: UInt, n: UInt)
    pre 2 * ((init_n + 1) - init_x)
    post 0
{
    x = init_x
    n = init_n
    // The invariant bounds the expected number of remaining coin flips.
    // Its expected decrease covers the one tick charged per iteration.
    // The extra one in n + 1 permits overshooting the target by one.
    // At exit, the invariant is nonnegative and covers the zero postexpectation.
    @invariant(2 * ((n + 1) - x))
    while x < n {
        var up: Bool = flip(0.5)
        if up {
            x = x + 2
        } else {
            x = x - 1
        }
        tick 1 // Count the single coin flip in this iteration.
    }
}
