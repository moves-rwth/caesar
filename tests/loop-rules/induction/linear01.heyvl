// RUN: @caesar @file
// Adapted from linear01.pgcl, translated by pgcl2heyvl.

@ert
coproc countdown(init_x: UInt) -> (x: UInt)
    pre 0.6 * init_x
    post 0
{
    x = init_x
    // The invariant bounds the expected number of remaining coin flips by 0.6 * x.
    // Each iteration decreases it by one in expectation, accounting for one coin flip.
    // At exit, it is nonnegative and covers the zero postexpectation.
    @invariant(0.6 * x)
    while x >= 2 {
        var short_step: Bool = flip(1/3)
        if short_step {
            x = x - 1
        } else {
            x = x - 2
        }
        tick 1 // Count the single coin flip in this iteration.
    }
}
