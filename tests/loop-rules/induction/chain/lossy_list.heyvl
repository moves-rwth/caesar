// RUN: @caesar @file --quantifier-instantiation e-matching

domain Exponentials {
    func exp(base: UReal, exponent: UInt): UReal =
        ite(exponent == 0, 1, base * exp(base, exponent - 1))
}

domain List {
    func len(l: List): UInt
    func pop(l: List): List

    axiom list_pop forall l: List @trigger(len(pop(l))).
        len(pop(l)) == len(l) - 1
}

// Every successful read removes one node, and assert 0 represents a failed read.
@wlp
proc lossy_list(init_l: List) -> (l: List)
    pre exp(0.5, len(init_l))
    post 1
{
    l = init_l
    @invariant(exp(0.5, len(l)))
    while len(l) > 0 {
        var read_succeeds: Bool = flip(0.5)
        if read_succeeds {
            l = pop(l)
        } else {
            assert 0
        }
    }
}
