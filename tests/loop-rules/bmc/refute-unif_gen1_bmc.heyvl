// RUN: bash -c '@caesar @file 2>&1 | grep -q "Counter-example to property found"'

// Adapted from pgcl/examples/refute-unif_gen1_bmc.pgcl.
// Coin recycling follows Lumbroso, "Optimal Discrete Uniform Generation from Coin Flips, and Applications" (2013).
// https://arxiv.org/abs/1304.1916

// For n > 0, generate an integer uniformly from 0 through n - 1.
// The claimed upper bound 0.49 is false for either output when n == 2.
coproc uniform_below(n: UInt, target: UInt) -> (candidate: UInt)
    pre ite(n == 2 && target < n, 0.49, 1)
    post [candidate == target]
{
    var range: UInt = 1
    candidate = 0
    var running: Bool = true

    @unroll(2, 0)
    while running {
        range = 2 * range
        candidate = 2 * candidate
        var bit: Bool = flip(0.5)
        if bit {
            candidate = candidate + 1
        } else {}

        if range >= n {
            if candidate < n {
                running = false
            } else {
                range = range - n
                candidate = candidate - n
            }
        } else {}
    }
}
