// RUN: @caesar @file

// The demonically fair random walk from McIver et al. (2018), Section 5.2.
@wp
proc demonic_walk(init_x: UInt) -> (x: UInt)
    pre 1
    post 1
{
    x = init_x
    // The variant x is nonnegative.
    // Each iteration decreases it by at least one with probability 0.5.
    // Its expected value does not increase under either demonic choice.
    @ast(true, x, v, 0.5, 1)
    while x > 0 {
        var down: Bool = flip(0.5)
        if down {
            x = x - 1
        } else {
            if \cap {
                x = x + 1
            } else {}
        }
    }
}
