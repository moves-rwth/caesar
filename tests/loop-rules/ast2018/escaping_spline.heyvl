// RUN: @caesar @file

// McIver et al. (2018), "A New Proof Rule for Almost-Sure Termination", Section 5.4.
// https://arxiv.org/abs/1711.03588

@wp
proc escaping_spline(init_x: UInt) -> (x: UInt)
    pre 1
    post 1
{
    x = init_x
    @ast(
        /* invariant: */    true,
        /* variant: */      x,
        /* variable: */     v,
        /* prob(v): */      1/(v+1),
        /* decrease(v): */  1
    )
    while x > 0 {
        var stop: Bool = flip(1 / (x + 1))
        if stop {
            x = 0
        } else {
            x = x + 1
        }
    }
}
