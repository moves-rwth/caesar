// RUN: @caesar @file

// The negative-binomial loop from McIver et al. (2018), Section 5.1.
@wp
proc countdown(init_x: UInt) -> (x: UInt)
    pre 1
    post 1
{
    x = init_x
    // The variant x is nonnegative.
    // Each iteration decreases it by at least one with probability 0.5.
    // Its expected value does not increase.
    @ast(true, x, v, 0.5, 1)
    while x > 0 {
        var step: Bool = flip(0.5)
        if step {
            x = x - 1
        } else {}
    }
}
