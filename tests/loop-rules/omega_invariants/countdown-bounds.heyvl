// RUN: @caesar @file

// The countdown terminates with probability one for every initial counter.
@wp
proc countdown_termination(init_x: UInt) -> (x: UInt)
    pre 1
    post 1
{
    x = init_x
    @omega_invariant(n, [x <= n])
    while x > 0 {
        x = x - 1
    }
}

// The expected number of ticks is at least the initial counter.
@ert
proc countdown_ticks(init_x: UInt) -> (x: UInt)
    pre init_x
    post 0
{
    x = init_x
    @omega_invariant(n, [x <= n] * x)
    while x > 0 {
        tick 1
        x = x - 1
    }
}
