// RUN: bash -c '@caesar @file 2>&1 | grep -q "Counter-example to verification found"'

// I_0 = 1 satisfies the base case in every state.
// The induction condition holds at x = 0 but fails at x = 1 and n = 0.
@wlp
coproc omega_wlp_induction_state() -> ()
    pre 0
    post 0
{
    var x: UInt = 0
    @omega_invariant(n, [n == 0 || (x == 0 && n == 1)])
    while true {
        x = 1
    }
}
