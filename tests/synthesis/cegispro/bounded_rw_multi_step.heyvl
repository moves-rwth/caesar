// RUN: @caesar synth --timeout 60 --refinement-mode fixed @file
// XFAIL: timeout

domain Invariants {
    syn func for_rw(ts: UInt [1,5], tx:UInt [0,2000000]) : EUReal
}

@wp coproc bounded_rw_multi() -> (x: UInt [0,200000])
pre 0.4
post [x == 200000]
{
    var s: UInt [1,5] = unif(1,5)
    @invariant(for_rw(s,x))
    while(0<x && x<200000 && 1<=s && s <= 5){
        var prob_choice: Bool = flip(0.5)
        if prob_choice {
           x = x - 1
        } else {
           if x == 1 {
            s = unif(1,5)
           }
           else {

           }
           x = x+s
        }
    x = x
    }
}
